# FoodBridge Platform Environment Configuration
# Copy this file to .env and configure your values

PORT=5000
NODE_ENV=production

# 32-byte cryptographically secure random secret
# Generate one using: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your_jwt_secret_min_32_characters_here

# Comma-separated list of permitted CORS origins
ALLOWED_ORIGINS=https://foodbridge.piragenth.dev,http://localhost,http://localhost:5173,http://localhost:80,http://54.234.233.124
